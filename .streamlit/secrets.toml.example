# Copy to .streamlit/secrets.toml and fill in. That file is gitignored.
#
# Keep every key at the TOP LEVEL, with no [section] headers. The app reads its
# configuration with os.getenv(), not st.secrets, and Streamlit only exports
# top-level scalar secrets into the process environment — a key nested under a
# [section] is reachable via st.secrets but invisible to os.getenv(), which
# would silently leave the app running on local SQLite instead of Neon.

# Neon Postgres. Without this the app falls back to SQLite at data/octavia.db.
# postgres:// is accepted and rewritten to postgresql:// for SQLAlchemy.
DATABASE_URL = "postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Seeds the first admin user. REQUIRED whenever DATABASE_URL is set — startup
# raises ValueError without it. Only used until an admin row exists.
CAS_ADMIN_PASSWORD = "change-me"

# Optional; these are the defaults.
CAS_ADMIN_USERNAME = "admin"
CAS_ADMIN_EMAIL = "admin@octavia.local"

# Optional override for the weekly PDF report. Leave unset and the app detects
# whether a Chrome/Chromium binary is present: PDF on when one is, HTML/CSV
# fallback when it isn't. Set "off" to force the fallback, "on" to force the
# PDF attempt on a host where detection guesses wrong.
# PDF_EXPORT_ENABLED = "off"
